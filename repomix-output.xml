    background-color: #0b2545;
    color: #1e293b;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
}

h1,
h2,
h3,
h4,
.font-heading {
    font-family: "Poppins", sans-serif;
}

canvas {
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    cursor: crosshair;
}

::-webkit-scrollbar {
    width: 6px;
    height: 6px;
}

::-webkit-scrollbar-track {
    background: rgba(15, 23, 42, 0.05);
    border-radius: 8px;
}

::-webkit-scrollbar-thumb {
    background: rgba(11, 37, 69, 0.2);
    border-radius: 8px;
}

::-webkit-scrollbar-thumb:hover {
    background: rgba(11, 37, 69, 0.4);
}

#main-drawer {
    will-change: transform;
}

.backdrop-blur-xs {
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
}

.draggable-item {
    touch-action: none;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease, opacity 0.15s ease;
}

.draggable-item:active {
    cursor: grabbing;
}

.draggable-item.dragging {
    position: fixed !important;
    z-index: 9999 !important;
    pointer-events: none !important;
    opacity: 0.85;
    transform: scale(1.05) rotate(2deg);
    box-shadow: 0 12px 28px rgba(11, 37, 69, 0.25) !important;
}

.drop-zone {
    min-height: 120px;
    transition: all 0.2s ease-in-out;
}

.drop-zone.drag-over {
    border-color: #0D6EFD !important;
    background-color: rgba(13, 110, 253, 0.08) !important;
    transform: scale(1.01);
    box-shadow: inset 0 0 12px rgba(13, 110, 253, 0.15);
}

.gm-item-row {
    transition: all 0.2s ease-in-out;
}

.gm-item-row:hover {
    border-color: #6b38fb;
    box-shadow: 0 2px 8px rgba(107, 56, 251, 0.1);
}

input:focus,
textarea:focus,
select:focus {
    outline: none;
}

#lkpd-fullscreen-scroll-body {
    -webkit-overflow-scrolling: touch !important;
    touch-action: pan-y !important;
    overflow-y: auto !important;
    scroll-behavior: smooth;
}

.lkpd-fullscreen-page-wrap {
    transition: transform 0.2s ease-in-out;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5);
}

.lkpd-fill-input:focus {
    border-color: #0D6EFD !important;
    box-shadow: 0 0 8px rgba(13, 110, 253, 0.5) !important;
    background-color: #ffffff !important;
    z-index: 40 !important;
}

#siswa-lkpd-pages canvas,
#lkpd-fullscreen-content canvas,
.lkpd-fullscreen-page-wrap canvas {
    touch-action: pan-y !important;
    user-select: auto !important;
